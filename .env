# Copy this file to .env and keep .env out of git.
# This project runs fully on your laptop: no API key is needed.

# Base model that gets fine-tuned for clause classification
BASE_MODEL=gpt2

# n-gram order (3 = trigram)
NGRAM_ORDER=3

# Where trained artifacts are saved
MODEL_DIR=artifacts
DATA_PATH=data/clauses.csv

# Fine-tuning settings (small values keep it fast on a CPU)
EPOCHS=4
BATCH_SIZE=8
LEARNING_RATE=5e-5
SEED=42
